# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://appuser:***@app-postgres:5432/appdb?schema=public"

# ── Single-user mode ──────────────────────────────────────────────────────────
# Fixed User.id used for all browser sessions. Keep the existing User table row.
DIVIDENDTRACKER_SINGLE_USER_ID="sangbong"

# ── Cron job authentication ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Used as Bearer token for /api/cron/* endpoints
CRON_SECRET="your-c...here"

# ── Web Push (VAPID) — /pocket same-day dividend alerts ─────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Public key is handed to browsers (non-secret); private key MUST stay secret.
# These live in .env (the file `--env-file .env` loads), NOT .env.local.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"

# ── Optional overrides ─────────────────────────────────────────────────────────
# Default CAD/USD exchange rate (fallback if /api/fx fails)
# DEFAULT_FX_RATE=1.36
